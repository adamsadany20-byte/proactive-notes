# Copy to server/.env and fill in. Every value is optional — the app runs in
# local-only mode for anything left blank.

# ---- AI tiers ---------------------------------------------------------------
# Two tiers; the app picks one via the in-app selector:
#   • Local ML  — always available, no key, runs entirely in the browser.
#   • Claude    — set ANTHROPIC_API_KEY below.
# Leave the key blank and the Claude tier reports "not configured" in the UI.

# ---- Claude tier ------------------------------------------------------------
ANTHROPIC_API_KEY=

# Split models (both optional — these ARE the defaults):
#   • AI_MODEL_CODE — tool suggestions + tool generation. Haiku is cheap, fast,
#     and plenty for structured JSON and React components.
#   • AI_MODEL_KNOWLEDGE — world-knowledge lookups (/api/enrich, /api/recommend,
#     with live web search). Sonnet balances knowledge depth and cost;
#     claude-opus-4-8 is deeper but ~2x the price per call.
# Setting AI_MODEL overrides BOTH (handy for testing one model everywhere).
AI_MODEL_CODE=claude-haiku-4-5
AI_MODEL_KNOWLEDGE=claude-sonnet-5
#AI_MODEL=

# Live web search on the world-knowledge routes (/api/enrich, /api/recommend).
# On by default — it's the biggest lever on knowledge quality. Set to false to
# make those calls cheaper but knowledge-only.
WEB_SEARCH=true

# Absolute ceiling on searches per AI call. Search-result tokens dominate the
# cost of a knowledge lookup, so this is the main cost lever. The prompts tell
# the model to search only for the specific fact it's missing and then stop, so
# it usually stays under this; the cap just guarantees no call runs away.
# (enrich asks for 1, recommend for up to 2; this clamps both.)
MAX_SEARCHES=2

# ---- Supabase (optional: accounts + multi-device sync) -----------------------
# NOTE: VITE_SUPABASE_* are FRONTEND build-time vars — Vite reads them from the
# repo-root env (.env.local) or the deploy platform's build env, NOT this
# server/.env. They're listed here only for reference. The values live in
# /.env.local (local dev) and as service env vars on Render (see render.yaml).
#   VITE_SUPABASE_URL=https://xxxx.supabase.co
#   VITE_SUPABASE_ANON_KEY=eyJhbGc...   (public by design — safe in the bundle)
#
# The SERVER needs these two Supabase values for billing that survives redeploys:
#
#   SUPABASE_JWT_SECRET      — verifies user tokens so ids can't be forged.
#                              Supabase → Settings → API → JWT Secret.
#   SUPABASE_SERVICE_ROLE_KEY — lets the server read/write the `entitlements`
#                              table (bypasses RLS). Supabase → Settings → API →
#                              service_role key. NEVER expose this to the browser.
#
# When SUPABASE_SERVICE_ROLE_KEY is set, paid credit is stored in Supabase and
# survives redeploys. Without it, credit falls back to a local flat file
# (server/.subscriptions.json) that resets on redeploy — fine for testing only.
# Both are REQUIRED before charging real money. (The server reuses the project
# URL from VITE_SUPABASE_URL; set SUPABASE_URL here too for LOCAL billing tests,
# since Vite's root env isn't loaded into the server process.)
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Billing (Stripe, monthly subscriptions) ---------------------------------
# The app is FULLY USABLE for free while BILLING_ENABLED is false (the default),
# so you can keep building and testing without paying. Flip it to true only when
# you want to charge.
#
# The model when enabled — two monthly plans, each with metered included usage:
#   • Free           — the on-device engine only. Never billed.
#   • Classification — £1/mo, includes £0.50 of classifier usage.
#   • Evolve AI      — £6/mo, includes £2.50 of coding + world-knowledge usage
#                      AND £0.50 of classifier usage, metered as two separate pots.
#   • Usage beyond a plan's included amount bills at OVERAGE_MARKUP per £1 of
#     real token cost, one cycle in arrears (added to the next invoice).
#   • Users can set their own spend limit, which caps OVERAGE only — the plan
#     fee itself never counts toward it.
BILLING_ENABLED=false

# Stripe secret key (sk_test_… / sk_live_…). No Price IDs needed — Checkout
# uses inline price_data.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_…) from `stripe listen` or the dashboard webhook.
# Without it the server still parses events (fine for local `stripe listen`).
# Subscribe the endpoint to: checkout.session.completed, invoice.paid,
# customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=

# ---- Prices & included usage (all in PENCE; these are the live knobs) --------
# Monthly plan prices. 100 = £1.00, 600 = £6.00.
# CLASSIFIER_PRICE_PENCE=100            # Classification plan, per month
# EVOLVE_PRICE_PENCE=600                # Evolve AI plan, per month
#
# How much real AI usage each plan includes before overage starts. Keep these
# WELL BELOW the plan price — a plan that bundles as much usage as it charges
# for makes every subscriber a loss once Stripe's ~2.9% + 30p is taken. The
# defaults bundle usage worth half the fee (50% gross margin).
# CLASSIFIER_INCLUDED_PENCE=50          # 50p classifier usage on Classification
# EVOLVE_AI_INCLUDED_PENCE=250          # £2.50 coding + world knowledge on Evolve
# EVOLVE_CLASSIFIER_INCLUDED_PENCE=50   # 50p classifier usage on Evolve
#
# What usage beyond the included amount costs: £ charged per £1 of real token
# cost. 2 = cost +100%. Set 1 to bill exactly what it costs you (no margin).
# OVERAGE_MARKUP=2
#
# Anthropic bills in USD; usage is metered in GBP pence.
# USD_TO_GBP=0.78

# ---- Legacy (one-time credit model — superseded, safe to ignore) -------------
# Only read for accounts created before the subscription model. There are none
# in practice; changing these affects nothing on a fresh deployment.
# ACTIVATION_PRICE_PENCE=1000    # old flat unlock fee (£10)
# ACTIVATION_CREDIT_PENCE=500    # token credit included with activation (£5)
# TOKEN_MARKUP=2                 # £ paid per £1 of tokens after that
# TOPUP_PRICE_PENCE=400          # old top-up purchase (£4 → £2 of tokens)

# Comma-separated clientIds that are NEVER billed. Put your own browser's id
# here (localStorage key `evolve.clientId`) so you can keep testing a deployed
# app for free even with billing enabled for everyone else.
FREE_CLIENT_IDS=

# ---- Beta pricing -----------------------------------------------------------
# During the beta, testers pay a REDUCED markup on usage beyond what their plan
# includes: 1.5 = token cost + 50%, versus the standard OVERAGE_MARKUP of 2
# (cost + 100%). Usage still funds itself, so the beta doesn't come out of your
# pocket, but testers aren't profited off while they're doing you a favour.
# Applies to the /api/billing/status quote, the cap math AND the Stripe invoice
# item, so the rate charged always matches the rate shown. 0 / unset = standard.
# Requires BILLING_ENABLED=true (otherwise nothing is charged at all).
BETA_MARKUP=1.5

# ---- Open beta (free-mode alternative) ---------------------------------------
# During a free public beta (BILLING_ENABLED=false) there is nothing to sell,
# but every Claude call still costs YOU real money at Anthropic. This gives each
# tester a hard allowance of REAL spend, in pence. Once a tester passes it, the
# paid routes return 402 `beta_limit` and the app falls back to the free,
# offline local engine — so they still have a working app, just no cloud AI.
# 0 / unset = no cap (unlimited usage, unlimited cost to you).
# Testers see their own usage in the app under Settings → Beta usage, and the
# /beta signup page states the figure. Owner ids in FREE_CLIENT_IDS bypass it.
# £2.00 per tester is a sensible starting point.
BETA_ALLOWANCE_PENCE=

# ---- Google Calendar --------------------------------------------------------
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console,
# enable the Google Calendar API, and add the redirect URI below to it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Where the browser should land after the OAuth dance (the Vite dev app).
APP_ORIGIN=http://localhost:5173

PORT=8787

# ---- Web Push (closed-app reminders) ----------------------------------------
# Reminder notifications that reach the user's phone even when the site is
# closed. Requires a STABLE VAPID key pair (changing it invalidates every
# existing subscription). Generate one with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# The public key is exposed to the browser; the private key stays server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI included with each push (spec-required). A mailto: is fine.
VAPID_SUBJECT=mailto:notify@evolve.app
# Optional shared secret guarding the cron sweep. If set, your pinger must call
#   POST /api/cron/tick?secret=THIS_VALUE
# (Notifications also fire from an internal 60s timer while the server is awake;
# the pinger is what wakes a free-tier host that has gone to sleep.)
CRON_SECRET=
